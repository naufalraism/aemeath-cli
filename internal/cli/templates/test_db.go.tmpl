{{if eq .Database "sqlite" -}}
// new{{.Pascal}}App uses a real SQLite database in a temporary directory.
{{- else -}}
// new{{.Pascal}}App uses a real SQLite database in a temporary directory, or
// the {{if eq .Database "postgres"}}PostgreSQL{{else}}MySQL{{end}} database in TEST_DATABASE_URL when it is set, so the
// tests also run against the database the app uses in production. Point it
// at a database for tests only: the tests add rows to it (they never delete
// rows they did not create).
{{- end}}
func new{{.Pascal}}App(t *testing.T) http.Handler {
	t.Helper()
{{- if eq .Database "sqlite"}}
	database, err := sqlite.Open(filepath.Join(t.TempDir(), "test.db"))
{{- else}}
	var database *db.Plugin
	var err error
	if dsn := os.Getenv("TEST_DATABASE_URL"); dsn != "" {
		database, err = {{.Database}}.Open(dsn)
	} else {
		database, err = sqlite.Open(filepath.Join(t.TempDir(), "test.db"))
	}
{{- end}}
	if err != nil {
		t.Fatal(err)
	}
	// Windows cannot delete a database file that is still open.
	t.Cleanup(func() { _ = database.Close() })

	app := aemeath.New()
	if err := app.RegisterPlugin(database); err != nil {
		t.Fatal(err)
	}
	handlers.{{.Pascal}}Handler(app)
	return app
}

func send{{.Pascal}}(h http.Handler, method, path, body string) *httptest.ResponseRecorder {
	var rd io.Reader
	if body != "" {
		rd = strings.NewReader(body)
	}
	req := httptest.NewRequest(method, path, rd)
	if body != "" {
		req.Header.Set("Content-Type", "application/json")
	}
	rec := httptest.NewRecorder()
	h.ServeHTTP(rec, req)
	return rec
}

func Test{{.Pascal}}CRUD(t *testing.T) {
	h := new{{.Pascal}}App(t)

	// Create
	rec := send{{.Pascal}}(h, "POST", "{{.Prefix}}/{{.Route}}", `{"name":"first"}`)
	if rec.Code != http.StatusCreated {
		t.Fatalf("create: status = %d, want 201 (body: %s)", rec.Code, rec.Body)
	}
	var created models.{{.Pascal}}
	if err := json.Unmarshal(rec.Body.Bytes(), &created); err != nil || created.ID == 0 || created.Name != "first" {
		t.Fatalf("create: unexpected body %s (err: %v)", rec.Body, err)
	}

	one := fmt.Sprintf("{{.Prefix}}/{{.Route}}/%d", created.ID)

	// Read
	rec = send{{.Pascal}}(h, "GET", one, "")
	if rec.Code != http.StatusOK {
		t.Fatalf("get: status = %d, want 200", rec.Code)
	}

	// Update
	rec = send{{.Pascal}}(h, "PUT", one, `{"name":"renamed"}`)
	if rec.Code != http.StatusOK || !strings.Contains(rec.Body.String(), "renamed") {
		t.Fatalf("update: status = %d, body = %s", rec.Code, rec.Body)
	}

	// List: the list is paged and a test database may hold many rows, so
	// look through the pages.
	found := false
	for offset := 0; !found; offset += 100 {
		rec = send{{.Pascal}}(h, "GET", fmt.Sprintf("{{.Prefix}}/{{.Route}}?limit=100&offset=%d", offset), "")
		var list []models.{{.Pascal}}
		if err := json.Unmarshal(rec.Body.Bytes(), &list); err != nil {
			t.Fatalf("list: unexpected body %s (err: %v)", rec.Body, err)
		}
		for _, item := range list {
			found = found || (item.ID == created.ID && item.Name == "renamed")
		}
		if len(list) < 100 {
			break
		}
	}
	if !found {
		t.Fatalf("list: the renamed item %d is missing", created.ID)
	}

	// Delete
	rec = send{{.Pascal}}(h, "DELETE", one, "")
	if rec.Code != http.StatusNoContent {
		t.Fatalf("delete: status = %d, want 204", rec.Code)
	}
	if rec = send{{.Pascal}}(h, "GET", one, ""); rec.Code != http.StatusNotFound {
		t.Fatalf("get after delete: status = %d, want 404", rec.Code)
	}
	if rec = send{{.Pascal}}(h, "DELETE", one, ""); rec.Code != http.StatusNotFound {
		t.Fatalf("deleting twice: status = %d, want 404", rec.Code)
	}
}

func Test{{.Pascal}}RejectsInvalidInput(t *testing.T) {
	h := new{{.Pascal}}App(t)

	rec := send{{.Pascal}}(h, "POST", "{{.Prefix}}/{{.Route}}", `{}`)
	if rec.Code != http.StatusUnprocessableEntity || !strings.Contains(rec.Body.String(), `"field":"name"`) {
		t.Fatalf("missing name: status = %d, body = %s, want 422 naming the field", rec.Code, rec.Body)
	}
	long := `{"name":"` + strings.Repeat("a", 101) + `"}`
	if rec := send{{.Pascal}}(h, "POST", "{{.Prefix}}/{{.Route}}", long); rec.Code != http.StatusUnprocessableEntity {
		t.Fatalf("name longer than 100 characters: status = %d, want 422", rec.Code)
	}
	if rec := send{{.Pascal}}(h, "POST", "{{.Prefix}}/{{.Route}}", `not json`); rec.Code != http.StatusBadRequest {
		t.Fatalf("invalid JSON: status = %d, want 400", rec.Code)
	}
	if rec := send{{.Pascal}}(h, "GET", "{{.Prefix}}/{{.Route}}/abc", ""); rec.Code != http.StatusBadRequest {
		t.Fatalf("non-numeric id: status = %d, want 400", rec.Code)
	}
	if rec := send{{.Pascal}}(h, "GET", "{{.Prefix}}/{{.Route}}/2147483647", ""); rec.Code != http.StatusNotFound {
		t.Fatalf("unknown id: status = %d, want 404", rec.Code)
	}
}

// The list is paged, so one request never returns the whole table. The
// database may hold rows of other tests, so only the shape is checked.
func Test{{.Pascal}}ListIsPaged(t *testing.T) {
	h := new{{.Pascal}}App(t)
	for _, name := range []string{"a", "b", "c"} {
		rec := send{{.Pascal}}(h, "POST", "{{.Prefix}}/{{.Route}}", `{"name":"`+name+`"}`)
		var created models.{{.Pascal}}
		if err := json.Unmarshal(rec.Body.Bytes(), &created); rec.Code != http.StatusCreated || err != nil {
			t.Fatalf("create %s: status = %d", name, rec.Code)
		}
		// Leave a shared test database as it was.
		t.Cleanup(func() { send{{.Pascal}}(h, "DELETE", fmt.Sprintf("{{.Prefix}}/{{.Route}}/%d", created.ID), "") })
	}
	page := func(query string) []models.{{.Pascal}} {
		t.Helper()
		rec := send{{.Pascal}}(h, "GET", "{{.Prefix}}/{{.Route}}?"+query, "")
		var list []models.{{.Pascal}}
		if err := json.Unmarshal(rec.Body.Bytes(), &list); err != nil {
			t.Fatalf("list ?%s: status = %d, body = %s", query, rec.Code, rec.Body)
		}
		return list
	}
	if got := page("limit=2"); len(got) != 2 {
		t.Errorf("?limit=2 gave %d items, want 2", len(got))
	}
	first, second := page("limit=1&offset=0"), page("limit=1&offset=1")
	if len(first) != 1 || len(second) != 1 || first[0].ID == second[0].ID {
		t.Errorf("?offset=0 and ?offset=1 gave %v and %v, want two different items", first, second)
	}
	if got := page(""); len(got) > 50 {
		t.Errorf("the default page has %d items, want at most 50", len(got))
	}
	for _, query := range []string{"limit=101", "offset=-1"} {
		if rec := send{{.Pascal}}(h, "GET", "{{.Prefix}}/{{.Route}}?"+query, ""); rec.Code != http.StatusUnprocessableEntity {
			t.Errorf("?%s: status = %d, want 422", query, rec.Code)
		}
	}
}
