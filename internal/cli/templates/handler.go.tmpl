}

// Update{{.Pascal}}In is the request of PUT {{.Prefix}}/{{.Route}}/{id}.
type Update{{.Pascal}}In struct {
	ID   int    `path:"id"`
	Name string `json:"name" validate:"required,min=1,max=100"`
}

type {{.Camel}}Store struct {
	mu     sync.RWMutex
	nextID int
	items  map[int]{{.Pascal}}
}

func new{{.Pascal}}Store() *{{.Camel}}Store {
	return &{{.Camel}}Store{nextID: 1, items: map[int]{{.Pascal}}{}}
}

// {{.Pascal}}Handler registers the CRUD routes for {{.Pascal}} under {{.Prefix}}/{{.Route}}.
func {{.Pascal}}Handler(app *aemeath.App) {
	store := new{{.Pascal}}Store()
	group := app.Group("{{.Prefix}}/{{.Route}}")

	// GET {{.Prefix}}/{{.Route}}
	aemeath.GET(group, "/", func(c *aemeath.Ctx, in List{{.Pascal}}In) ([]{{.Pascal}}, error) {
		store.mu.RLock()
		defer store.mu.RUnlock()
		all := make([]{{.Pascal}}, 0, len(store.items))
		for _, item := range store.items {
			all = append(all, item)
		}
		sort.Slice(all, func(i, j int) bool { return all[i].ID < all[j].ID })
		start := min(in.Offset, len(all))
		return all[start:min(start+in.pageSize(), len(all))], nil
	}, aemeath.Summary("List {{.Pascal}} items"), aemeath.Tags("{{.Pascal}}"))

	// POST {{.Prefix}}/{{.Route}}
	aemeath.POST(group, "/", func(c *aemeath.Ctx, in Create{{.Pascal}}In) ({{.Pascal}}, error) {
		store.mu.Lock()
		defer store.mu.Unlock()
		item := {{.Pascal}}{ID: store.nextID, Name: in.Name}
		store.items[item.ID] = item
		store.nextID++
		return item, nil
	}, aemeath.Summary("Create a {{.Pascal}}"), aemeath.Tags("{{.Pascal}}"), aemeath.Status(201))

	// GET {{.Prefix}}/{{.Route}}/{id}
	aemeath.GET(group, "/{id}", func(c *aemeath.Ctx, in {{.Pascal}}ByIDIn) ({{.Pascal}}, error) {
		store.mu.RLock()
		defer store.mu.RUnlock()
		item, ok := store.items[in.ID]
		if !ok {
			return {{.Pascal}}{}, aemeath.NotFound("{{.Pascal}} not found")
		}
		return item, nil
	}, aemeath.Summary("Get a {{.Pascal}}"), aemeath.Tags("{{.Pascal}}"))

	// PUT {{.Prefix}}/{{.Route}}/{id}
	aemeath.PUT(group, "/{id}", func(c *aemeath.Ctx, in Update{{.Pascal}}In) ({{.Pascal}}, error) {
		store.mu.Lock()
		defer store.mu.Unlock()
		item, ok := store.items[in.ID]
		if !ok {
			return {{.Pascal}}{}, aemeath.NotFound("{{.Pascal}} not found")
		}
		item.Name = in.Name
		store.items[in.ID] = item
		return item, nil
	}, aemeath.Summary("Update a {{.Pascal}}"), aemeath.Tags("{{.Pascal}}"))

	// DELETE {{.Prefix}}/{{.Route}}/{id}
	aemeath.DELETE(group, "/{id}", func(c *aemeath.Ctx, in {{.Pascal}}ByIDIn) (struct{}, error) {
		store.mu.Lock()
		defer store.mu.Unlock()
		if _, ok := store.items[in.ID]; !ok {
			return struct{}{}, aemeath.NotFound("{{.Pascal}} not found")
		}
		delete(store.items, in.ID)
		return struct{}{}, nil
	}, aemeath.Summary("Delete a {{.Pascal}}"), aemeath.Tags("{{.Pascal}}"), aemeath.Status(204))
}
