# syntax=docker/dockerfile:1
{{if .Web}}
# Stage 1: build the React app
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package*.json ./
RUN npm install --no-audit --no-fund
COPY web/ ./
RUN npm run build
{{end}}
# Stage {{if .Web}}2{{else}}1{{end}}: build the Go server
FROM golang:{{.GoVersion}}-alpine AS builder
WORKDIR /src

# Download dependencies first so Docker can cache this layer.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/app .

# Stage {{if .Web}}3{{else}}2{{end}}: run
FROM alpine:3
RUN apk add --no-cache ca-certificates tzdata \
 && addgroup -S app && adduser -S -G app app
WORKDIR /app
COPY --from=builder /out/app .
{{if .Web}}COPY --from=web /web/dist ./web/dist
{{end}}
# Do not run as root, but let that user write here (a SQLite file such as app.db).
RUN chown app:app /app
USER app

# Adjust if your app listens on a different port (the PORT variable).
EXPOSE 3000
ENTRYPOINT ["./app"]
