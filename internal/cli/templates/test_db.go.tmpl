package handlers_test

import (
	"encoding/json"
	"io"
	"net/http"
	"net/http/httptest"
	"path/filepath"
	"strings"
	"testing"

	"github.com/naufalraism/aemeath"
	"github.com/naufalraism/aemeath/db"

	"{{.Module}}/handlers"
	"{{.Module}}/models"
)

// new{{.Pascal}}App uses a real SQLite database in a temporary directory.
func new{{.Pascal}}App(t *testing.T) http.Handler {
	t.Helper()
	database, err := db.Open(filepath.Join(t.TempDir(), "test.db"))
	if err != nil {
		t.Fatal(err)
	}
	// Windows cannot delete a database file that is still open.
	t.Cleanup(func() { _ = database.Close() })

	app := aemeath.New()
	if err := app.RegisterPlugin(database); err != nil {
		t.Fatal(err)
	}
	handlers.{{.Pascal}}Handler(app)
	return app
}

func send{{.Pascal}}(h http.Handler, method, path, body string) *httptest.ResponseRecorder {
	var rd io.Reader
	if body != "" {
		rd = strings.NewReader(body)
	}
	req := httptest.NewRequest(method, path, rd)
	if body != "" {
		req.Header.Set("Content-Type", "application/json")
	}
	rec := httptest.NewRecorder()
	h.ServeHTTP(rec, req)
	return rec
}

func Test{{.Pascal}}CRUD(t *testing.T) {
	h := new{{.Pascal}}App(t)

	// Create
	rec := send{{.Pascal}}(h, "POST", "{{.Prefix}}/{{.Route}}", `{"name":"first"}`)
	if rec.Code != http.StatusCreated {
		t.Fatalf("create: status = %d, want 201 (body: %s)", rec.Code, rec.Body)
	}
	var created models.{{.Pascal}}
	if err := json.Unmarshal(rec.Body.Bytes(), &created); err != nil || created.ID == 0 || created.Name != "first" {
		t.Fatalf("create: unexpected body %s (err: %v)", rec.Body, err)
	}

	// Read
	rec = send{{.Pascal}}(h, "GET", "{{.Prefix}}/{{.Route}}/1", "")
	if rec.Code != http.StatusOK {
		t.Fatalf("get: status = %d, want 200", rec.Code)
	}

	// Update
	rec = send{{.Pascal}}(h, "PUT", "{{.Prefix}}/{{.Route}}/1", `{"name":"renamed"}`)
	if rec.Code != http.StatusOK || !strings.Contains(rec.Body.String(), "renamed") {
		t.Fatalf("update: status = %d, body = %s", rec.Code, rec.Body)
	}

	// List
	rec = send{{.Pascal}}(h, "GET", "{{.Prefix}}/{{.Route}}", "")
	var list []models.{{.Pascal}}
	if err := json.Unmarshal(rec.Body.Bytes(), &list); err != nil || len(list) != 1 || list[0].Name != "renamed" {
		t.Fatalf("list: unexpected body %s (err: %v)", rec.Body, err)
	}

	// Delete
	rec = send{{.Pascal}}(h, "DELETE", "{{.Prefix}}/{{.Route}}/1", "")
	if rec.Code != http.StatusNoContent {
		t.Fatalf("delete: status = %d, want 204", rec.Code)
	}
	if rec = send{{.Pascal}}(h, "GET", "{{.Prefix}}/{{.Route}}/1", ""); rec.Code != http.StatusNotFound {
		t.Fatalf("get after delete: status = %d, want 404", rec.Code)
	}
	if rec = send{{.Pascal}}(h, "DELETE", "{{.Prefix}}/{{.Route}}/1", ""); rec.Code != http.StatusNotFound {
		t.Fatalf("deleting twice: status = %d, want 404", rec.Code)
	}
}

func Test{{.Pascal}}RejectsInvalidInput(t *testing.T) {
	h := new{{.Pascal}}App(t)

	rec := send{{.Pascal}}(h, "POST", "{{.Prefix}}/{{.Route}}", `{}`)
	if rec.Code != http.StatusUnprocessableEntity || !strings.Contains(rec.Body.String(), `"field":"name"`) {
		t.Fatalf("missing name: status = %d, body = %s, want 422 naming the field", rec.Code, rec.Body)
	}
	long := `{"name":"` + strings.Repeat("a", 101) + `"}`
	if rec := send{{.Pascal}}(h, "POST", "{{.Prefix}}/{{.Route}}", long); rec.Code != http.StatusUnprocessableEntity {
		t.Fatalf("name longer than 100 characters: status = %d, want 422", rec.Code)
	}
	if rec := send{{.Pascal}}(h, "POST", "{{.Prefix}}/{{.Route}}", `not json`); rec.Code != http.StatusBadRequest {
		t.Fatalf("invalid JSON: status = %d, want 400", rec.Code)
	}
	if rec := send{{.Pascal}}(h, "GET", "{{.Prefix}}/{{.Route}}/abc", ""); rec.Code != http.StatusBadRequest {
		t.Fatalf("non-numeric id: status = %d, want 400", rec.Code)
	}
	if rec := send{{.Pascal}}(h, "GET", "{{.Prefix}}/{{.Route}}/999", ""); rec.Code != http.StatusNotFound {
		t.Fatalf("unknown id: status = %d, want 404", rec.Code)
	}
}
