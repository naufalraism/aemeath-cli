package main

import (
	"log"
	"os"

	"github.com/naufalraism/aemeath"
)
{{if not .Web}}
// HelloOut is the response of GET /.
type HelloOut struct {
	Message string `json:"message"`
}

// hello registers GET /. "/{$}" is "/" and nothing else: a plain "/" would
// also answer every path no other route takes (/admin/.env, a typo in an API
// URL) with 200. main_test.go checks both.
func hello(app *aemeath.App) {
	aemeath.GET(app, "/{$}", func(c *aemeath.Ctx, _ struct{}) (HelloOut, error) {
		return HelloOut{Message: "Hello from Aemeath!"}, nil
	}, aemeath.Summary("Say hello"))
}
{{end}}
func main() {
	app := aemeath.New()

	// Behind a reverse proxy or load balancer (Docker, Nginx, most hosting
	// platforms), every request seems to come from the proxy. Put this first so
	// that logs and rate limits see the visitor's address instead:
	//
	//	app.Use(aemeath.RealIP(aemeath.PrivateNetworks()...))
	app.Use(
		aemeath.SecurityHeaders(),
		aemeath.RequestID(),
		aemeath.Logger(),
		aemeath.Recover(),
		aemeath.CORS(),
		aemeath.Gzip(),
	)

	// GET /healthz (liveness) and GET /readyz (readiness) for load balancers.
	app.EnableHealth()

	// On Kubernetes or behind a load balancer, keep serving for a few seconds
	// after the stop signal while /readyz already answers 503, so that no
	// request is refused during a deploy:
	//
	//	app.SetShutdownDelay(5 * time.Second)

	// "aemeath generate" registers what it creates right after these two
	// comments (plugins first, because handlers may need them). Move them
	// wherever you like, but keep the order: plugins, then handlers.
	// aemeath:plugins
	// aemeath:handlers
{{if .Web}}
	// The React app in web/. Run "npm run build" there to fill web/dist; while
	// developing, use "npm run dev" in web/ instead (it proxies /api to this server).
	app.Static("/", "web/dist")
{{else}}
	hello(app)
{{end}}
	// Interactive API docs at /docs. /client.ts, /schemas.ts (Zod) and /hooks.ts
	// (React Query) are generated from the same Go types.
	//
	// They are public: anyone can read your routes and their types. Before
	// production, decide whether that is fine. To show them only to admins,
	// register them on a group with your own check instead:
	//
	//	admin := app.Group("/admin", requireAdmin)
	//	admin.EnableDocs(aemeath.Info{...}) // /admin/docs
	//	admin.EnableClient()                // /admin/client.ts, ...
	//
	// https://naufalraism.github.io/aemeath/guide/auth#api-docs-in-production
	app.EnableDocs(aemeath.Info{Title: "{{.Title}}", Version: "0.1.0"})
	app.EnableClient()

	port := os.Getenv("PORT")
	if port == "" {
		port = "3000"
	}
	log.Printf("server listening on http://localhost:%s (docs: /docs)", port)
	if err := app.Listen(":" + port); err != nil {
		log.Fatal(err)
	}
}
