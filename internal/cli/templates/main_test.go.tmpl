package main

import (
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/naufalraism/aemeath"
)

func get(app *aemeath.App, path string) *httptest.ResponseRecorder {
	rec := httptest.NewRecorder()
	app.ServeHTTP(rec, httptest.NewRequest("GET", path, nil))
	return rec
}

func TestHello(t *testing.T) {
	app := aemeath.New()
	hello(app)

	if rec := get(app, "/"); rec.Code != http.StatusOK || !strings.Contains(rec.Body.String(), "Hello from Aemeath!") {
		t.Fatalf("GET /: status = %d, body = %s", rec.Code, rec.Body)
	}
	// GET / must not answer every other path.
	for _, path := range []string{"/does-not-exist", "/admin/.env", "/hello/"} {
		if rec := get(app, path); rec.Code != http.StatusNotFound {
			t.Errorf("GET %s: status = %d, want 404", path, rec.Code)
		}
	}
}
